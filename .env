# Copy to .env and adjust. The single value below has a working default for
# local development, so .env is optional.
#
# Vite only exposes variables prefixed with VITE_, and inlines them at BUILD
# time. A production image therefore has to be built with the value it will
# run against -- changing it afterwards has no effect on an existing build.
# The Dockerfile takes it as a build arg for build-time compilation:
#   docker build --build-arg VITE_API_BASE_URL=... .
#   docker compose build --build-arg VITE_API_BASE_URL=... client
#
# Additionally, when running the container, /docker-entrypoint.d/40-generate-config.sh
# dynamically injects VITE_API_BASE_URL from .env into /config.js at container startup.
#
# Alternatively, users can dynamically override this URL in their browser via the
# Settings button on the login screen without rebuilding the container.
#
# This URL is resolved by the browser, not from inside the container, so it
# should be the address a user's browser can reach.

# The backend's CORS_ORIGINS must list whatever origin this app is served from,
# and its COOKIE_SECURE must be true once that origin is HTTPS.

VITE_API_BASE_URL=http://localhost:8000/api

# ------- PLEASE UPDATE THIS SETTING BY SPECIFYING THE HOST ------
# 1. API endpoint called by clients' browsers:
#VITE_API_BASE_URL=http://<YOUR_BACKEND_HOST_OR_IP>:8000/api

# 2. Origin(s) from which the browser accesses the frontend:
#CORS_ORIGINS=http://<YOUR_CLIENT_HOST_OR_IP>:5173