# Copy to .env and adjust. Both values have working defaults for local
# development, so .env is optional.
#
# Vite only exposes variables prefixed with VITE_, and inlines them at BUILD
# time. A production image therefore has to be built with the values it will
# run against -- changing them afterwards has no effect on an existing build.
# The Dockerfile takes both as build args for exactly that reason:
#
#   docker build --build-arg VITE_API_BASE_URL=... --build-arg VITE_API_TOKEN=... .
#
# This URL is resolved by the browser, not from inside the container, so it
# should be the address a user's browser can reach.

VITE_API_BASE_URL=http://localhost:8000/api

# Must match the backend's API_TOKEN.
#
# Note this token is inlined into the JavaScript bundle and is readable by
# anyone who loads the page. It gates casual access, not determined access;
# treat it as public and never reuse it as a secret elsewhere.
VITE_API_TOKEN=sse-staff-token
