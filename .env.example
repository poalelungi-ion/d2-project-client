# Copy to .env and adjust. The single value below has a working default for
# local development, so .env is optional.
#
# Vite only exposes variables prefixed with VITE_, and inlines them at BUILD
# time. A production image therefore has to be built with the value it will
# run against -- changing it afterwards has no effect on an existing build.
# The Dockerfile takes it as a build arg for exactly that reason:
#
#   docker build --build-arg VITE_API_BASE_URL=... .
#
# This URL is resolved by the browser, not from inside the container, so it
# should be the address a user's browser can reach.

#
# The backend's CORS_ORIGINS must list whatever origin this app is served from,
# and its COOKIE_SECURE must be true once that origin is HTTPS.

VITE_API_BASE_URL=http://localhost:8000/api
