{
  "name": "d2-project-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:complexity": "ESLINT_CODE_QUALITY_REPORT=gl-code-quality-report.json eslint --config eslint.config.ci.js src/ --format gitlab; node scripts/complexity-summary.mjs gl-code-quality-report.json",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --reporter=json --outputFile.junit=junit.xml --outputFile.json=vitest-results.json",
    "test:summary": "node scripts/test-summary.mjs vitest-results.json coverage/coverage-summary.json",
    "test:watch": "vitest",
    "build:e2e": "VITE_API_BASE_URL=/api npm run build",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:e2e:headed": "npm run build:e2e && playwright test --headed --workers=1",
    "test:e2e:ci": "playwright test",
    "test:e2e:summary": "node scripts/e2e-summary.mjs playwright-results.json"
  },
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "ag-grid-community": "^31.0.1",
    "ag-grid-react": "^31.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.10.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-formatter-gitlab": "^7.2.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.7"
  }
}
